# ============================================================
# AniFlix — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit the .env file with real secrets.
# For production builds, set all values via EAS Secrets instead.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Admin Access ──────────────────────────────────────────────
# The email address of the admin account.
# REQUIRED: If unset, admin panel will be inaccessible in the app.
EXPO_PUBLIC_ADMIN_EMAIL=your_admin_email@example.com

# ── Google AdMob ──────────────────────────────────────────────
# Found in: Google AdMob Console → Apps / Ad Units
# Use TEST IDs during development (safe, no policy risk):
#   Android Test App ID: ca-app-pub-3940256099942544~3347511713
#   Android Test Banner: ca-app-pub-3940256099942544/6300978111
#   Android Test Rewarded: ca-app-pub-3940256099942544/5224354917
#   iOS Test App ID: ca-app-pub-3940256099942544~1458002511
#   iOS Test Banner: ca-app-pub-3940256099942544/2934735716
#   iOS Test Rewarded: ca-app-pub-3940256099942544/1712485313
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# ── RASEDI Payment Gateway ────────────────────────────────────
# Found in: RASEDI Merchant Dashboard
# Set RASEDI_MODE=live for real payments. Defaults to test if unset.
RASEDI_SECRET_KEY=your_rasedi_secret_key_here
RASEDI_WEBHOOK_SECRET=your_rasedi_webhook_secret_here
RASEDI_MODE=test

# ── Supabase Storage / CORS ───────────────────────────────────
# The private video storage bucket name (default: videos-private)
PRIVATE_VIDEO_BUCKET=videos-private

# Comma-separated list of allowed origins for Edge Function CORS.
# Example: https://your-app.com,exp://192.168.1.1:8081
ALLOWED_WEB_ORIGINS=exp://localhost:8081

# ── Edge Function Secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# These are NOT EXPO_PUBLIC_ — they are server-side only.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key (set in Supabase, not here)
# RASEDI_SECRET_KEY is also needed as an Edge Function secret
