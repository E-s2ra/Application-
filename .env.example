# =============================================================================
# AniFlix Environment Variables Template (.env.example)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── Supabase Cloud Configuration ──────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Admin Access ──────────────────────────────────────────────
# This is used by the admin-operations Edge Function to verify admin identity.
# Set this as a Supabase Edge Function secret (not just in .env).
# Run: supabase secrets set ADMIN_EMAIL=your-admin@email.com
ADMIN_EMAIL=your-admin@email.com

# ── CORS Configuration ─────────────────────────────────────────
# Comma-separated list of allowed web origins for the admin-operations Edge Function.
# Run: supabase secrets set ALLOWED_WEB_ORIGINS=https://yourapp.com,exp://localhost:8081
ALLOWED_WEB_ORIGINS=exp://localhost:8081,http://localhost:8081

# ── Google AdMob Ad Units (Android & iOS) ─────────────────────
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# ── Storage Config ─────────────────────────────────────────────
PRIVATE_VIDEO_BUCKET=videos-private

# ── E2E Testing (Playwright) ───────────────────────────────────
# Used only for Playwright test runs. Never hardcode these in test files.
PLAYWRIGHT_ADMIN_EMAIL=your-admin@email.com
PLAYWRIGHT_ADMIN_PASSWORD=your-admin-password
