# =============================================================================
# AniFlix Environment Variables Template (.env.example)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── Supabase Cloud Configuration ──────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Development-only convenience. Production bundles ignore this even if it is set.
EXPO_PUBLIC_BYPASS_AUTH=false

# ── Admin Account Setup ────────────────────────────────────────
# These 3 vars are used by:  npm run setup:admin
#
# ADMIN_EMAIL    → The email address of the admin account.
#                  This account is automatically granted role='admin' in the DB.
# ADMIN_PASSWORD → Used to create the admin account if it doesn't exist yet.
#                  After first run you can change the password from Supabase dashboard.
# SUPABASE_SECRET_KEY → server-only secret key from Supabase Dashboard → Settings → API.
#                       NEVER prefix this with EXPO_PUBLIC_ or expose it in client code.
#
# Usage:
#   1. Fill in the 3 values below in your .env
#   2. Run: npm run setup:admin
#   3. Done — log in with ADMIN_EMAIL / ADMIN_PASSWORD
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-admin-password
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# ── CORS Configuration ─────────────────────────────────────────
# Comma-separated list of allowed web origins for the admin-operations Edge Function.
# Run: supabase secrets set ALLOWED_WEB_ORIGINS=https://yourapp.com,exp://localhost:8081
ALLOWED_WEB_ORIGINS=exp://localhost:8081,http://localhost:8081

# ── Google AdMob Ad Units (Android & iOS) ─────────────────────
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# ── Storage Config ─────────────────────────────────────────────
PRIVATE_VIDEO_BUCKET=videos-private

# ── E2E Testing (Playwright) ───────────────────────────────────
# Used only for Playwright test runs. Never hardcode these in test files.
PLAYWRIGHT_ADMIN_EMAIL=your-admin@email.com
PLAYWRIGHT_ADMIN_PASSWORD=your-admin-password

# ── SMTP Email Configuration ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_ADMIN_EMAIL=your-email@gmail.com
SMTP_SENDER_NAME=AniFlix Support
