# Created after `npx supabase start` by running `npx supabase status -o env`.
# Copy this file to .env.docker (which is ignored by Git), then load it before
# starting Expo locally. Do not put service_role keys in an Expo environment.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_with_the_local_anon_key_from_supabase_status

# A hosted backup is required before any migration operation.
# SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
